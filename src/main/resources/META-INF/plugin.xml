<idea-plugin>
    <id>com.jpc.uka</id>
    <name>sMate</name>
    <vendor email="" url="">huage2580</vendor>

    <description><![CDATA[
     sMate is your stock market companion in the IDE.
    ]]></description>

    <!-- please see http://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
         on how to target different products -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Add your extensions here -->
        <toolWindow anchor="bottom" id="uka" factoryClass="FundWindow"/>
        <applicationConfigurable id="uka_settings" displayName="sMate" instance="SettingsWindow"/>
        <notificationGroup id="uka Notification Group" displayType="BALLOON"
                           bundle="messages.SMateBundle" key="notification.group.smate"/>
    </extensions>

    <actions>
        <!-- Add your actions here -->
    </actions>

</idea-plugin>
